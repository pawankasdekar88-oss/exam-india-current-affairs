<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#087FC1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="☰   Exam India"
                    android:textColor="#FFFFFF"
                    android:textSize="27sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔔   👤"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp"/>
            </LinearLayout>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="#FFFFFF"
                android:hint="🔍  Search Exam, Topic, Notes, MCQs..."
                android:padding="14dp"
                android:textSize="15sp"/>

        </LinearLayout>

        <!-- BANNER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_margin="16dp"
            android:padding="18dp"
            android:orientation="vertical"
            android:background="#FFF4D9">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prepare for\nYour Dream Exam"
                android:textColor="#102B55"
                android:textSize="23sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Notes • MCQs • Current Affairs • Mock Tests"
                android:textColor="#334E68"
                android:textSize="13sp"/>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:layout_marginTop="8dp"
                android:text="Start Learning  →"
                android:textSize="13sp"/>
        </LinearLayout>

        <!-- EXAM TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="4dp"
            android:text="Popular Exams"
            android:textColor="#102B55"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <!-- ROW 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:text="🇮🇳\nUPSC Civil Services\nIAS / IPS / IFS"
                android:textColor="#102B55"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="#FFF1D6"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:text="🗺️\nMPPSC State PSC\nMadhya Pradesh"
                android:textColor="#102B55"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="#FFE0E5"/>
        </LinearLayout>

        <!-- ROW 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:text="🏅\nSSC CGL\nGraduate Level"
                android:textColor="#102B55"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="#DDEFFF"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:text="🏅\nSSC CHSL\n12th Level"
                android:textColor="#102B55"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="#DDF8E9"/>
        </LinearLayout>

        <!-- ROW 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:text="🏦\nBanking\nIBPS / SBI PO &amp; Clerk"
                android:textColor="#102B55"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="#FFE1E1"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:text="🚆\nRailway\nRRB NTPC &amp; Group D"
                android:textColor="#102B55"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="#E9DEFF"/>
        </LinearLayout>

        <!-- ROW 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:text="🩺\nNEET-UG\nMedical"
                android:textColor="#102B55"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="#DDF8E9"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:text="⚙️\nJEE Main / Advanced\nEngineering"
                android:textColor="#102B55"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="#FFF1D6"/>
        </LinearLayout>

        <!-- ROW 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:text="👮\nPolice / SI\nConstable Exams"
                android:textColor="#102B55"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="#E9DEFF"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:text="📖\nTeaching Exams\nCTET / State TET"
                android:textColor="#102B55"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="#DDEFFF"/>
        </LinearLayout>

        <!-- QUICK MENU -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="📄\nStudy Material"
                android:textColor="#102B55"
                android:textSize="13sp"
                android:background="#DDF8E9"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="☑️\nMock Tests"
                android:textColor="#102B55"
                android:textSize="13sp"
                android:background="#FFE1E1"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="📰\nCurrent Affairs"
                android:textColor="#102B55"
                android:textSize="13sp"
                android:background="#DDEFFF"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="💡\nGuidance"
                android:textColor="#102B55"
                android:textSize="13sp"
                android:background="#E9DEFF"/>
        </LinearLayout>

        <!-- BOTTOM NAV -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🏠\nHome"
                android:textColor="#087FC1"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="📚\nMy Courses"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="📊\nProgress"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="👤\nProfile"
                android:textSize="13sp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
