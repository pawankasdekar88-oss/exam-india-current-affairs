<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08111F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="भारतवर्ष और भारतीय संस्कृति"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MPPSC PRE — GENERAL STUDIES"
            android:textColor="#B8C7D9"
            android:textSize="17sp"
            android:paddingBottom="25dp" />

        <Button
            android:id="@+id/studyMaterialButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="📚  अध्ययन सामग्री"
            android:textSize="17sp"
            android:textAllCaps="false"
            android:textColor="#222222"
            android:backgroundTint="#D9D9D9"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/importantFactsButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="⭐  महत्वपूर्ण तथ्य"
            android:textSize="17sp"
            android:textAllCaps="false"
            android:textColor="#222222"
            android:backgroundTint="#D9D9D9"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/mcqButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="📝  MCQ Practice"
            android:textSize="17sp"
            android:textAllCaps="false"
            android:textColor="#222222"
            android:backgroundTint="#D9D9D9"
            android:layout_marginBottom="12dp" />

    </LinearLayout>

</ScrollView>
