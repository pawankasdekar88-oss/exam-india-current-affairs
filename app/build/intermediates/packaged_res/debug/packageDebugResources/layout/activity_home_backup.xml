<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exam India"
            android:textColor="#172B4D"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="आपकी परीक्षा की तैयारी, एक जगह"
            android:textColor="#667085"
            android:textSize="15sp" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:background="#FFFFFF"
            android:hint="🔍  परीक्षा या विषय खोजें"
            android:padding="14dp"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="क्या करना चाहते हैं?"
            android:textColor="#172B4D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:text="📚  Subjects"
            android:textSize="16sp" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:text="📝  MCQ Practice"
            android:textSize="16sp" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:text="🎯  Mock Tests"
            android:textSize="16sp" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:text="📰  Current Affairs"
            android:textSize="16sp" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:text="💼  Vacancies"
            android:textSize="16sp" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:text="🔐  Login"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
